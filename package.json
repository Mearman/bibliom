{
  "name": "bibgraph",
  "version": "24.10.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repository": "https://github.com/Mearman/BibGraph.git",
  "scripts": {
    "_lint": "eslint . --cache",
    "a11y": "pnpm --filter @bibgraph/web run a11y",
    "build": "turbo run _build",
    "clean": "rm -rf dist coverage .turbo .tanstack node_modules/.vite && pnpm --filter='*' clean",
    "cli": "pnpm --filter @bibgraph/cli _dev",
    "coverage:report": "echo 'Coverage reports already generated during test execution'",
    "deps:analyze": "turbo run _build --dry=json > deps-graph.json && echo 'Dependency graph generated: deps-graph.json'",
    "deps:audit": "pnpm audit --audit-level moderate",
    "deps:knip": "knip",
    "deps:knip:fix": "knip --fix",
    "deps:outdated": "pnpm outdated",
    "deps:update": "pnpm update --interactive --latest",
    "dev": "turbo run _dev --filter=@bibgraph/web",
    "generate:test-urls": "tsx scripts/generate-test-urls.ts",
    "licenses:check": "tsx tools/scripts/check-licenses.ts",
    "licenses:generate": "monorepo-license-checker --markdown --exclude-private-packages",
    "licenses:summary": "monorepo-license-checker --exclude-private-packages",
    "lighthouse": "sh -c '(pnpm -F @bibgraph/web exec vite preview &) ; sleep 5; lhci autorun'",
    "lint": "turbo run _lint",
    "lint:fix": "pnpm --filter '*' run lint:fix",
    "prepare": "husky",
    "preview": "turbo run _preview --filter=@bibgraph/web",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "speckit": "uvx --from git+https://github.com/github/spec-kit.git specify",
    "syncpack": "syncpack",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:lint": "syncpack lint",
    "syncpack:list": "syncpack list-mismatches",
    "test": "NODE_OPTIONS='--max-old-space-size=6144' turbo run _test",
    "test:accessibility": "pnpm a11y",
    "test:accessibility:dev": "pnpm --filter @bibgraph/web run a11y:dev",
    "test:aggregate": "tsx scripts/aggregate-tests.ts",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=6144' turbo run _test:coverage",
    "test:performance": "pnpm lighthouse",
    "test:urls": "tsx scripts/test-urls.ts",
    "test:web": "pnpm --filter @bibgraph/web run _test",
    "typecheck": "turbo run _typecheck",
    "typecheck:ci": "turbo run _typecheck",
    "typecheck:fast": "tsx scripts/fast-typecheck.ts",
    "validate": "turbo run _typecheck _lint _test _build"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@eslint-react/eslint-plugin": "2.5.4",
    "@eslint/js": "9.39.2",
    "@eslint/markdown": "7.5.1",
    "@octokit/rest": "22.0.1",
    "@playwright/test": "1.57.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.2",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@stylistic/eslint-plugin": "5.7.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3": "7.4.3",
    "@types/d3-force": "3.0.10",
    "@types/d3-random": "3.0.3",
    "@types/node": "25.0.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.182.0",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "@typescript-eslint/rule-tester": "8.53.0",
    "@typescript-eslint/utils": "8.52.0",
    "@vanilla-extract/vite-plugin": "5.1.4",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/eslint-plugin": "1.6.6",
    "@vitest/ui": "4.0.16",
    "chokidar": "5.0.0",
    "eslint": "9.39.2",
    "eslint-config-xo": "0.49.0",
    "eslint-config-xo-typescript": "9.0.0",
    "eslint-formatter-compact": "9.0.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-autofix": "2.2.0",
    "eslint-plugin-barrel-files": "3.0.1",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.0.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-perfectionist": "5.3.1",
    "eslint-plugin-playwright": "2.4.1",
    "eslint-plugin-prefer-arrow-functions": "3.9.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-regexp": "2.10.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sonarjs": "3.0.5",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-yml": "1.19.1",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "jsdom": "27.4.0",
    "knip": "5.80.2",
    "koa": "3.1.1",
    "lint-staged": "16.2.7",
    "monorepo-license-checker": "0.3.0",
    "msw": "2.12.7",
    "prettier": "3.7.4",
    "semantic-release": "25.0.2",
    "syncpack": "13.0.4",
    "tslib": "2.8.1",
    "tsx": "4.21.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "7.3.5",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-static-copy": "4.1.1",
    "vite-tsconfig-paths": "6.0.4",
    "vitest": "4.1.4",
    "vitest-axe": "0.1.0",
    "zod": "4.3.5"
  },
  "nx": {
    "includedScripts": []
  }
}
